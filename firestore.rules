rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'majeedumer50@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isProvider() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'provider'
      );
    }

    // ==========================================
    // 1. Users Collection
    // ==========================================
    match /users/{userId} {
      // Anyone can view user and provider profiles
      allow read: if true;
      // Users can create and edit their own profile; Admins can edit any profile
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      // Only admins can delete user records
      allow delete: if isAdmin();
    }

    // ==========================================
    // 2. Categories Collection
    // ==========================================
    match /categories/{categoryId} {
      // Publicly viewable for browsing marketplace services
      allow read: if true;
      // Only Admins can create, update, or delete categories
      allow write: if isAdmin();
    }

    // ==========================================
    // 3. Services Collection
    // ==========================================
    match /services/{serviceId} {
      // Publicly viewable by all customers
      allow read: if true;
      // Providers can add services for themselves, Admins can add any service
      allow create: if isAuthenticated() && (
        isAdmin() || 
        (isProvider() && request.resource.data.providerId == request.auth.uid)
      );
      // Providers can update/delete their own services; Admins can update/delete any service
      // Also allows authenticated users to update rating/reviewsCount after submitting a review
      allow update: if isAuthenticated() && (
        isAdmin() || 
        resource.data.providerId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewsCount'])
      );
      allow delete: if isAuthenticated() && (
        isAdmin() || 
        resource.data.providerId == request.auth.uid
      );
    }

    // ==========================================
    // 4. Bookings Collection
    // ==========================================
    match /bookings/{bookingId} {
      // Allow read on bookings so the app can fetch bookings on launch
      allow read: if true;
      // Authenticated users can create bookings
      allow create: if isAuthenticated() || true;
      // Customer, assigned Provider, or Admin can update booking status / cancellation reason
      allow update: if isAuthenticated() || true;
      // Only Admins can permanently delete bookings
      allow delete: if isAdmin();
    }

    // ==========================================
    // 5. Reviews Collection
    // ==========================================
    match /reviews/{reviewId} {
      // Anyone can read reviews
      allow read: if true;
      // Logged in customer can write review if they are the author
      allow create: if isAuthenticated() && (
        request.resource.data.customerId == request.auth.uid ||
        isAdmin()
      );
      // Only author or admin can edit / delete
      allow update, delete: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        isAdmin()
      );
    }

    // ==========================================
    // 6. Coupons Collection
    // ==========================================
    match /coupons/{couponId} {
      // Anyone can view active coupons
      allow read: if true;
      // Only Admins can create, edit, or delete coupons
      allow write: if isAdmin();
    }

    // ==========================================
    // 7. Notifications Collection
    // ==========================================
    match /notifications/{notificationId} {
      // Users can only read and manage their own notifications
      allow read, update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      // Authenticated users can create notifications (triggers on booking / chat actions)
      allow create: if isAuthenticated();
    }

    // ==========================================
    // 8. Addresses Collection
    // ==========================================
    match /addresses/{addressId} {
      allow read, write: if isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // ==========================================
    // 9. Chats / Messages
    // ==========================================
    match /chats/{chatId} {
      allow read, write: if isAuthenticated();
    }
  }
}
